{
  "name": "chillyptv",
  "version": "0.1.0",
  "private": true,
  "description": "ChillyPTV \u2014 a modern IPTV player (Xtream Codes + M3U/XMLTV) with multi-view, catch-up, recordings, reminders and more.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build && tsc -p server/tsconfig.json",
    "start": "node dist-server/server/index.js",
    "mock": "tsx mock/server.ts",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.24",
    "hls.js": "^1.7.4",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.66.0",
    "mpegts.js": "^1.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}