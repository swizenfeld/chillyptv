{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "../dist-server",
    "rootDir": ".."
  },
  "include": ["./**/*.ts", "../shared/**/*.ts"]
}
